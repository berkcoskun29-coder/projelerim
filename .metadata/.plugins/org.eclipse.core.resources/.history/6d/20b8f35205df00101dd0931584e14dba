    private void startWave(int waveNumber) {
        waveActive = true;
        spawnCounter = 0;
        enemiesSpawnedThisWave = 0;
        bossSpawnedThisWave = false;

        enemiesToSpawnInWave = 5 + waveNumber * 2;
        spawnInterval = Math.max(30, 80 - waveNumber * 3);
    }

    // --------- SAVE / LOAD ---------
    private void saveGame() {
        if (state != GameState.GAME && state != GameState.PAUSE) return;

        try (PrintWriter pw = new PrintWriter(new FileWriter(SAVE_FILE))) {
            pw.println(currentMap.name());
            pw.println(difficulty.name());
            pw.println(wave + " " + score + " " + lives + " " + gold);

            pw.println(towers.size());
            for (Tower t : towers) {
                pw.println(
                        t.getX() + " "
                                + t.getY() + " "
                                + t.getType().name() + " "
                                + t.getLevel());
            }

            JOptionPane.showMessageDialog(this, "Oyun kaydedildi (F9 ile yukleyebilirsin).");
        } catch (IOException ex) {
            JOptionPane.showMessageDialog(this, "Kaydetme hatasi: " + ex.getMessage(),
                    "Hata", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void loadGame() {
        File f = new File(SAVE_FILE);
        if (!f.exists()) {
            JOptionPane.showMessageDialog(this, "Kayit bulunamadi.", "Bilgi", JOptionPane.INFORMATION_MESSAGE);
            return;
        }

        try (BufferedReader br = new BufferedReader(new FileReader(f))) {
            String line;

            MapType m = MapType.valueOf(br.readLine().trim());
            Difficulty d = Difficulty.valueOf(br.readLine().trim());
            line = br.readLine();
            String[] parts = line.split("\\s+");
            int w = Integer.parseInt(parts[0]);
            int sc = Integer.parseInt(parts[1]);
            int lv = Integer.parseInt(parts[2]);
            int gd = Integer.parseInt(parts[3]);

            currentMap = m;
            difficulty = d;

            enemies.clear();
            bullets.clear();
            towers.clear();
            selectedTower = null;

            initPathsForMap(currentMap);
            wave = w;
            score = sc;
            lives = lv;
            gold = gd;

            // XP / Level ve global çarpanları resetle
            playerLevel = 1;
            currentXp = 0;
            xpForNextLevel = 100;
            damageMultiplier = 1.0;
            goldGainMultiplier = 1.0;
            Tower.setGlobalDamageMultiplier(damageMultiplier);

            // Hız ve skill durumu reset
            speedMultiplier = 1.0;
            updateAccumulator = 0.0;
            meteorCooldownRemaining = 0;
            freezeCooldownRemaining = 0;
            meteorArmed = false;
            meteorEffects.clear();
            freezeOverlayTicks = 0;
            deathParticles.clear();
            floatingTexts.clear();

            noLifeLostSoFar = true;    // eski kayıtta ne olduğu tutulmuyor, sıfırladık
            towerSoldEver = false;
            usedNonSlowTower = false;
            achWave10NoLifeLost = false;
            achNoSellWave10 = false;
            achSlowOnlyWave5 = false;

            int towerCount = Integer.parseInt(br.readLine().trim());
            for (int i = 0; i < towerCount; i++) {
                line = br.readLine();
                String[] p = line.split("\\s+");
                double tx = Double.parseDouble(p[0]);
                double ty = Double.parseDouble(p[1]);
                TowerType tt = TowerType.valueOf(p[2]);
                int lvl = Integer.parseInt(p[3]);

                Tower t = new Tower(tx, ty, tt);
                while (t.getLevel() < lvl && t.canUpgrade()) {
                    t.forceUpgradeWithoutCost();
                }
                towers.add(t);

                if (tt != TowerType.SLOW) {
                    usedNonSlowTower = true;
                }
            }

            startWave(wave);
            state = GameState.GAME;
            JOptionPane.showMessageDialog(this, "Oyun yüklendi.");
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(this, "Yukleme hatasi: " + ex.getMessage(),
                    "Hata", JOptionPane.ERROR_MESSAGE);
        }
    }

    // --------- TIMER LOOP ---------
    @Override
    public void actionPerformed(ActionEvent e) {
        if (state == GameState.GAME) {
            // Hız kontrolü: speedMultiplier 2.0 ise aynı frame'de 2 kez updateGame çalışır
            updateAccumulator += speedMultiplier;
            while (updateAccumulator >= 1.0) {
                updateGame();
                updateAccumulator -= 1.0;
            }
        }
        repaint();
    }

    private void updateGame() {
    	animTick++;
        // Skill cooldown decrement
        if (meteorCooldownRemaining > 0) meteorCooldownRemaining--;
        // Skill cooldown decrement
        if (meteorCooldownRemaining > 0) meteorCooldownRemaining--;
        if (freezeCooldownRemaining > 0) freezeCooldownRemaining--;
        // Freeze overlay süresini azalt
        if (freezeOverlayTicks > 0) {
            freezeOverlayTicks--;
        }

        // Meteor efektlerini güncelle
        Iterator<MeteorEffect> effIt = meteorEffects.iterator();
        while (effIt.hasNext()) {
            MeteorEffect eff = effIt.next();
            eff.update();
            if (!eff.isAlive()) {
                effIt.remove();
            }
        }

        // 💥 Ölüm parçacıklarını güncelle
        Iterator<DeathParticle> pIt = deathParticles.iterator();
        while (pIt.hasNext()) {
            DeathParticle p = pIt.next();
            p.update();
            if (!p.isAlive()) {
                pIt.remove();
            }
        }

        // 💰 Floating text'leri güncelle
        Iterator<FloatingText> ftIt = floatingTexts.iterator();
        while (ftIt.hasNext()) {
            FloatingText ft = ftIt.next();
            ft.update();
            if (!ft.isAlive()) {
                ftIt.remove();
            }
        }

        // Spawn
        if (waveActive) {
            spawnCounter++;

            boolean bossWave = (wave % 5 == 0);

            if (bossWave && !bossSpawnedThisWave && spawnCounter % spawnInterval == 0) {
                List<Point> route = chooseRouteForType(EnemyType.BOSS);
                enemies.add(new Enemy(route.get(0).x, route.get(0).y, EnemyType.BOSS, route));
                bossSpawnedThisWave = true;
                enemiesSpawnedThisWave++;
            } else if (spawnCounter % spawnInterval == 0 && enemiesSpawnedThisWave < enemiesToSpawnInWave) {
                EnemyType type = pickEnemyTypeForWave(wave, bossWave);
                List<Point> route = chooseRouteForType(type);
                enemies.add(new Enemy(route.get(0).x, route.get(0).y, type, route));
                enemiesSpawnedThisWave++;
            }
        }

        // Düşmanlar
        Iterator<Enemy> enemyIt = enemies.iterator();
        while (enemyIt.hasNext()) {
            Enemy en = enemyIt.next();
            en.update(enemies); // healer vs aura için liste lazım

            if (en.isReachedEnd()) {
                lives--;
                noLifeLostSoFar = false;
                enemyIt.remove();
            } else if (!en.isAlive()) {
                // Skor
                score += en.getScoreValue();

                // Altın: seviye buff'ı ile çarp
                int gainedGold = (int) Math.round(en.getReward() * goldGainMultiplier);
                gold += gainedGold;

                // XP kazan
                int gainedXp = en.getScoreValue();
                gainXp(gainedXp);

                // 💥 Ölüm parçacıkları oluştur
                spawnDeathParticles(en, (en.getType() == EnemyType.BOSS));

                // 💰 Floating text ekle (altın + xp)
                floatingTexts.add(new FloatingText(
                        en.getX(),
                        en.getY() - 10,
                        "+" + gainedGold,
                        new Color(255, 215, 0)   // altın sarısı
                ));

                floatingTexts.add(new FloatingText(
                        en.getX(),
                        en.getY() - 25,
                        "+" + gainedXp + " XP",
                        new Color(180, 220, 255) // açık mavi
                ));

                enemyIt.remove();
            }
        }

        // Dalga bitti mi?
        if (waveActive && enemiesSpawnedThisWave >= enemiesToSpawnInWave && enemies.isEmpty()) {
            waveActive = false;
            wave++;
            startWave(wave);
            checkMidRunAchievements();
        }

        // Kuleler
        for (Tower t : towers) {
            t.update(enemies, bullets);
        }

        // Mermiler
        Iterator<Bullet> bulletIt = bullets.iterator();
        while (bulletIt.hasNext()) {
            Bullet b = bulletIt.next();
            b.update();
            if (!b.isAlive()) {
                bulletIt.remove();
            }
        }

        // Game Over
        if (lives <= 0) {
            checkGameOverAchievements();
            state = GameState.MENU;
            JOptionPane.showMessageDialog(this,
                    "Oyun Bitti!\nSkor: " + score + "\nUlastigin Dalga: " + wave,
                    "Game Over",
                    JOptionPane.INFORMATION_MESSAGE);
            resetGame();
        }
    }

    // ----- XP & Level Sistemi -----
    private void gainXp(int amount) {
        currentXp += amount;

        // Birkaç seviye birden atlayabilsin diye while
        while (currentXp >= xpForNextLevel) {
            currentXp -= xpForNextLevel;
            playerLevel++;

            // Bir sonraki seviye için gereken XP'yi artır
            xpForNextLevel = (int) (xpForNextLevel * 1.4);

            // Her level'da buff ver
            damageMultiplier += 0.05;      // +%5 kule hasarı
            goldGainMultiplier += 0.05;    // +%5 altın kazancı

            // Kulelerin global damage çarpanını güncelle
            Tower.setGlobalDamageMultiplier(damageMultiplier);
        }
    }

    // 💥 Düşman ölünce parçacık saçan yardımcı metod
    private void spawnDeathParticles(Enemy en, boolean big) {
        int count = big ? 30 : 15;  // boss ise daha fazla parçacık
        for (int i = 0; i < count; i++) {
            double angle = Math.random() * Math.PI * 2;
            double speed = (big ? 2.5 : 2.0) + Math.random() * 1.0;
            double vx = Math.cos(angle) * speed;
            double vy = Math.sin(angle) * speed;

            Color c = big
                    ? new Color(255, 100, 50)
                    : new Color(230, 60, 60);

            deathParticles.add(new DeathParticle(
                    en.getX(),
                    en.getY(),
                    vx,
                    vy,
                    c
            ));
        }
    }

    private EnemyType pickEnemyTypeForWave(int waveNum, boolean bossWave) {
        int roll = random.nextInt(100);

        // Erken dalgalar: NORMAL/FAST ağırlık
        if (waveNum < 4) {
            if (roll < 70) return EnemyType.NORMAL;
            else if (roll < 90) return EnemyType.FAST;
            else return EnemyType.HEALER;
        } else if (waveNum < 7) {
            if (roll < 40) return EnemyType.NORMAL;
            else if (roll < 65) return EnemyType.FAST;
            else if (roll < 80) return EnemyType.TANK;
            else if (roll < 90) return EnemyType.HEALER;
            else return EnemyType.AURA;
        } else {
            if (roll < 30) return EnemyType.NORMAL;
            else if (roll < 55) return EnemyType.FAST;
            else if (roll < 75) return EnemyType.TANK;
            else if (roll < 88) return EnemyType.HEALER;
            else if (roll < 96) return EnemyType.AURA;
            else return EnemyType.SMART;
        }
    }

    private List<Point> chooseRouteForType(EnemyType type) {
        if (pathAlt.isEmpty()) return pathMain;

        if (type != EnemyType.SMART) {
            // NORMAL random
            return random.nextBoolean() ? pathMain : pathAlt;
        }

        // SMART: kule yoğunluğuna göre yol seçsin
        double mainScore = towerDensityScore(pathMain);
        double altScore = towerDensityScore(pathAlt);
        // daha az kule olan yolu tercih et
        return mainScore <= altScore ? pathMain : pathAlt;
    }

    private double towerDensityScore(List<Point> path) {
        double sum = 0;
        for (Tower t : towers) {
            // yol segmentlerine olan minimum uzaklık
            double d = distanceToPath((int) t.getX(), (int) t.getY(), path);
            sum += 1.0 / (1.0 + d); // yakınsa skor yüksek
        }
        return sum;
    }

    // --------- ACHIEVEMENTS ---------
    private void checkMidRunAchievements() {
        // 10. dalgaya can kaybetmeden gel
        if (!achWave10NoLifeLost && wave >= 10 && noLifeLostSoFar) {
            achWave10NoLifeLost = true;
            JOptionPane.showMessageDialog(this,
                    "Achievement Unlocked:\n\"10. dalgaya can kaybetmeden gel\"",
                    "Basari", JOptionPane.INFORMATION_MESSAGE);
        }

        // 10. dalgaya kule satmadan gel
        if (!achNoSellWave10 && wave >= 10 && !towerSoldEver) {
            achNoSellWave10 = true;
            JOptionPane.showMessageDialog(this,
                    "Achievement Unlocked:\n\"10. dalgaya kule satmadan gel\"",
                    "Basari", JOptionPane.INFORMATION_MESSAGE);
        }

        // 5. dalgaya kadar sadece SLOW kule
        if (!achSlowOnlyWave5 && wave >= 5 && !usedNonSlowTower) {
            achSlowOnlyWave5 = true;
            JOptionPane.showMessageDialog(this,
                    "Achievement Unlocked:\n\"Sadece SLOW kule ile 5. dalgaya gel\"",
                    "Basari", JOptionPane.INFORMATION_MESSAGE);
        }
    }

    private void checkGameOverAchievements() {
        StringBuilder sb = new StringBuilder();
        sb.append("Oyun Bitti.\n\nKazandigin Basarilar:\n");

        boolean any = false;
        if (achWave10NoLifeLost) {
            sb.append("- 10. dalgaya can kaybetmeden gel\n");
            any = true;
        }
        if (achNoSellWave10) {
            sb.append("- 10. dalgaya kule satmadan gel\n");
            any = true;
        }
        if (achSlowOnlyWave5) {
            sb.append("- Sadece slow kule ile 5. dalgaya gel\n");
            any = true;
        }

        if (!any) {
            sb.append("- Henuz basari yok, denemeye devam!\n");
        }

        JOptionPane.showMessageDialog(this, sb.toString(), "Basari Ozeti", JOptionPane.INFORMATION_MESSAGE);
    }

    // --------- RENDER ---------
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);

        // Anti-aliasing (daha yumuşak çizimler)
        Graphics2D g2dAA = (Graphics2D) g;
        g2dAA.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        switch (state) {
            case MENU:
                drawMenu(g);
                break;
            case SETTINGS:
                drawSettings(g);
                break;
            case MAP_SELECT:
                drawMapSelect(g);
                break;
            case GAME:
            case PAUSE:
                drawGame(g);
                if (state == GameState.PAUSE) drawPauseOverlay(g);
                break;
        }
    }

    // ---- MENU EKRANI ----
    private void drawMenu(Graphics g) {
        Graphics2D g2 = (Graphics2D) g;
        g2.setColor(new Color(20, 20, 30));
        g2.fillRect(0, 0, getWidth(), getHeight());

        g2.setFont(bigFont);
        g2.setColor(Color.WHITE);
        String title = "JAVA TOWER DEFENSE";
        int tw = g2.getFontMetrics().stringWidth(title);
        g2.drawString(title, (getWidth() - tw) / 2, 120);

        g2.setFont(midFont);
        drawMenuButton(g2, "OYUNA BASLA", 230, 220);
        drawMenuButton(g2, "MAP SECIMI", 230, 280);
        drawMenuButton(g2, "AYARLAR", 230, 340);
        drawMenuButton(g2, "CIKIS", 230, 400);

        g2.setFont(smallFont);
        g2.setColor(Color.LIGHT_GRAY);
        g2.drawString("Secili Map: " + currentMap,
                20, getHeight() - 55);
        g2.drawString("Zorluk: " + difficulty,
                20, getHeight() - 35);
        g2.drawString("Kontroller: 1-2-3 kule | Q Meteor | F Freeze | P Pause | ESC Menu | F5 Save | F9 Load",
                getWidth() - 540, getHeight() - 35);
    }

    private void drawMenuButton(Graphics2D g2, String text, int x, int y) {
        int w = 440;
        int h = 40;
        g2.setColor(new Color(50, 50, 80));
        g2.fillRoundRect(x, y, w, h, 15, 15);
        g2.setColor(Color.WHITE);
        g2.drawRoundRect(x, y, w, h, 15, 15);

        int sw = g2.getFontMetrics().stringWidth(text);
        int sh = g2.getFontMetrics().getAscent();
        g2.drawString(text, x + (w - sw) / 2, y + (h + sh) / 2 - 3);
    }

    // ---- SETTINGS EKRANI ----
    private void drawSettings(Graphics g) {
        Graphics2D g2 = (Graphics2D) g;
        g2.setColor(new Color(15, 15, 25));
