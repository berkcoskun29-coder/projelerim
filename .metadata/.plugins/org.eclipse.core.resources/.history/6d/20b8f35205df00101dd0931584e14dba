    private void drawFreezeOverlay(Graphics2D g2) {
        if (freezeOverlayTicks <= 0) return;

        // 0..1 arası oran
        float ratio = freezeOverlayTicks / (float) (freezeDurationTicks + 40);
        if (ratio < 0f) ratio = 0f;
        if (ratio > 1f) ratio = 1f;

        int alpha = (int) (80 * ratio); // max 80 opacity

        g2.setColor(new Color(120, 180, 255, alpha));
        g2.fillRect(0, 0, getWidth(), getHeight());
    }
