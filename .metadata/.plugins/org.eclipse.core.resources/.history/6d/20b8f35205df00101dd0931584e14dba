    // ---- GAME EKRANI ----
    private void drawGame(Graphics g) {
        Graphics2D g2 = (Graphics2D) g;
        // Screen shake offset'i
        int offsetX = 0;
        int offsetY = 0;
        if (shakeTicks > 0) {
            shakeTicks--;
            offsetX = random.nextInt(shakeMagnitude * 2 + 1) - shakeMagnitude;
            offsetY = random.nextInt(shakeMagnitude * 2 + 1) - shakeMagnitude;
        }

        // Dünya (harita, kuleler, düşmanlar) için translate
        g2.translate(offsetX, offsetY);


        // Zemin karo
        for (int i = 0; i < getWidth(); i += 40) {
            for (int j = 0; j < getHeight(); j += 40) {
                if (((i + j) / 40) % 2 == 0) g2.setColor(new Color(30, 30, 40));
                else g2.setColor(new Color(25, 25, 35));
                g2.fillRect(i, j, 40, 40);
            }
        }

        // Path MAIN
        drawPath(g2, pathMain, new Color(90, 80, 40), new Color(160, 150, 90));
        // Path ALT
        if (!pathAlt.isEmpty()) {
            drawPath(g2, pathAlt, new Color(70, 70, 90), new Color(120, 120, 180));
        }
    


        // Kuleler
        for (Tower t : towers) drawTower(g2, t);

        // Düşmanlar
        for (Enemy en : enemies) drawEnemy(g2, en);

     // Mermiler + trail
        for (Bullet b : bullets) {
            java.util.List<double[]> tr = b.getTrail();
            // Önce trail çiz
            for (int i = 0; i < tr.size(); i++) {
                double[] p = tr.get(i);
                // Eskiye gittikçe saydamlaşsın
                float t = (float) (i + 1) / tr.size(); // 0..1
                int alpha = (int) (80 * t);           // max 80

                g2.setColor(new Color(200, 200, 255, alpha));
                int size = 4;
                g2.fillOval((int) p[0] - size / 2, (int) p[1] - size / 2, size, size);
            }

            // Mermi başı (daha parlak)
            g2.setColor(Color.WHITE);
            g2.fillOval((int) b.getX() - 3, (int) b.getY() - 3, 6, 6);
        }


        // 💥 Ölüm parçacıkları
        drawDeathParticles(g2);

        // 💰 Floating text'ler
        drawFloatingTexts(g2);

        // 🔥 Meteor görsel efektleri
        drawMeteorEffects(g2);

        // ❄ Freeze overlay efekti
        drawFreezeOverlay(g2);

        // Meteor hedef önizlemesi (Q ile silahlanmışsa)
        if (meteorArmed) {
            Point mp = getMousePosition();
            if (mp != null) {
                g2.setColor(new Color(255, 120, 0, 70));
                g2.fillOval(mp.x - meteorRadius, mp.y - meteorRadius,
                        meteorRadius * 2, meteorRadius * 2);
                g2.setColor(new Color(255, 200, 100, 150));
                g2.setStroke(new BasicStroke(2));
                g2.drawOval(mp.x - meteorRadius, mp.y - meteorRadius,
                        meteorRadius * 2, meteorRadius * 2);
            }
        }
     // Dünya translate'ini geri al (HUD sabit kalsın)
        g2.translate(-offsetX, -offsetY);

        // HUD + Kule açıklama paneli
        drawHUD(g2);
        drawTowerInfoPanel(g2);
    }

