    private void drawPath(Graphics2D g2, List<Point> path, Color base, Color edge) {
        if (path.size() < 2) return;
        g2.setStroke(new BasicStroke(30, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
        g2.setColor(base);
        for (int i = 0; i < path.size() - 1; i++) {
            Point p1 = path.get(i);
            Point p2 = path.get(i + 1);
            g2.drawLine(p1.x, p1.y, p2.x, p2.y);
        }
        g2.setStroke(new BasicStroke(4));
        g2.setColor(edge);
        for (int i = 0; i < path.size() - 1; i++) {
            Point p1 = path.get(i);
            Point p2 = path.get(i + 1);
            g2.drawLine(p1.x, p1.y, p2.x, p2.y);
        }
    }
    private Color darken1(Color c, float factor) {
        factor = Math.max(0f, Math.min(1f, factor));
        int r = (int) (c.getRed() * factor);
        int g = (int) (c.getGreen() * factor);
        int b = (int) (c.getBlue() * factor);
        return new Color(r, g, b, c.getAlpha());
    }


    private void drawTower(Graphics2D g2, Tower t) {
        int cx = (int) t.getX();
        int cy = (int) t.getY();

        // Menzil dairesi (soft)
        int r = (int) t.getRangeDisplay();
        g2.setColor(new Color(0, 255, 0, 25));
        g2.fillOval(cx - r, cy - r, r * 2, r * 2);

        // Kule gölgesi
        g2.setColor(new Color(0, 0, 0, 120));
        g2.fillOval(cx - 20, cy - 10 + 10, 40, 20);

        // Tipine göre renkler
        Color baseColor;
        Color accentColor;
        switch (t.getType()) {
            case BASIC:
                baseColor = new Color(70, 200, 70);
                accentColor = new Color(180, 255, 180);
                break;
            case SNIPER:
                baseColor = new Color(80, 200, 230);
                accentColor = new Color(180, 235, 255);
                break;
            case SLOW:
            default:
                baseColor = new Color(210, 210, 90);
                accentColor = new Color(255, 255, 160);
                break;
        }

        Color darkBase = darken1(baseColor, 0.7f);

        // Dış gövde (büyük, koyu)
        g2.setColor(darkBase);
        g2.fillOval(cx - 18, cy - 18, 36, 36);

        // Ana gövde (biraz küçük, ana renk)
        g2.setColor(baseColor);
        g2.fillOval(cx - 15, cy - 15, 30, 30);

        // Üst taret (çok küçük, parlak)
        g2.setColor(accentColor);
        g2.fillOval(cx - 9, cy - 9, 18, 18);
        g2.setColor(Color.BLACK);
        g2.drawOval(cx - 9, cy - 9, 18, 18);

        // Namlu (şimdilik yukarı bakıyor, tipine göre renk)
        g2.setStroke(new BasicStroke(5, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
        if (t.getType() == TowerType.SLOW) {
            g2.setColor(new Color(120, 170, 255));
        } else if (t.getType() == TowerType.SNIPER) {
            g2.setColor(new Color(60, 60, 60));
        } else {
            g2.setColor(new Color(90, 90, 90));
        }
        g2.drawLine(cx, cy, cx, cy - 22);

        // Level halkaları (kule etrafında küçük yaylar)
        g2.setStroke(new BasicStroke(2));
        for (int i = 0; i < t.getLevel(); i++) {
            float startAngle = 60 + i * 70;   // seviyeye göre farklı açılar
            g2.setColor(new Color(255, 255, 255, 160));
            g2.drawArc(cx - 22, cy - 22, 44, 44,
                    (int) startAngle, 40);
        }

        // Tip ikonu (küçük harf veya sembol)
        g2.setFont(new Font("Arial", Font.BOLD, 11));
        g2.setColor(Color.BLACK);
        String iconText;
        if (t.getType() == TowerType.BASIC) iconText = "B";
        else if (t.getType() == TowerType.SNIPER) iconText = "S";
        else iconText = "L"; // Slow
        int sw = g2.getFontMetrics().stringWidth(iconText);
        g2.drawString(iconText, cx - sw / 2, cy + 4);

        // Seçili kule vurgusu
        if (t == selectedTower) {
            g2.setStroke(new BasicStroke(2));
            g2.setColor(new Color(255, 230, 120));
            g2.drawOval(cx - 22, cy - 22, 44, 44);
        }
    }


    private void drawEnemy(Graphics2D g2, Enemy en) {
        int cx = (int) en.getX();
        int baseCy = (int) en.getY();

        // Hafif yukarı-aşağı zıplama (bobbing)
        int bob = (int) (Math.sin((animTick + cx) * 0.25) * 2); // -2..2 piksel
        int cy = baseCy + bob;

        boolean isBoss = (en.getType() == EnemyType.BOSS);
        int size = isBoss ? 30 : 22;


        // AURA ve HEALER için hafif aura halkası
        if (en.getType() == EnemyType.AURA) {
            g2.setColor(new Color(255, 255, 0, 40));
            int auraR = 45;
            g2.fillOval(cx - auraR, cy - auraR, auraR * 2, auraR * 2);
        } else if (en.getType() == EnemyType.HEALER) {
            g2.setColor(new Color(120, 255, 160, 35));
            int auraR = 40;
            g2.fillOval(cx - auraR, cy - auraR, auraR * 2, auraR * 2);
        }

        // Boss için dış parıltı
        if (isBoss) {
            g2.setColor(new Color(200, 120, 255, 80));
            int glow = size + 16;
            g2.fillOval(cx - glow / 2, cy - glow / 2, glow, glow);
        }

        // Gövde rengi
        Color bodyColor;
        switch (en.getType()) {
            case NORMAL:
                bodyColor = new Color(220, 60, 60);
                break;
            case FAST:
                bodyColor = new Color(245, 160, 60);
                break;
            case TANK:
                bodyColor = new Color(120, 60, 60);
                break;
            case BOSS:
                bodyColor = new Color(170, 70, 200);
                break;
            case HEALER:
                bodyColor = new Color(80, 200, 140);
                break;
            case AURA:
                bodyColor = new Color(230, 220, 90);
                break;
            case SMART:
            default:
                bodyColor = new Color(80, 170, 230);
                break;
        }

        Color borderColor = darken1(bodyColor, 0.7f);
        Color innerColor = new Color(
                Math.min(255, bodyColor.getRed() + 25),
                Math.min(255, bodyColor.getGreen() + 25),
                Math.min(255, bodyColor.getBlue() + 25)
        );

        // Gövde (iki katmanlı, yuvarlatılmış kare)
        int half = size / 2;
        g2.setColor(borderColor);
        g2.fillRoundRect(cx - half - 2, cy - half - 2, size + 4, size + 4, 10, 10);

        g2.setColor(bodyColor);
        g2.fillRoundRect(cx - half, cy - half, size, size, 10, 10);

        // Ortada iç parlama
        g2.setColor(innerColor);
        g2.fillRoundRect(cx - half + 3, cy - half + 3, size - 6, size - 6, 8, 8);

        // Kenar çizgisi
        g2.setColor(Color.BLACK);
        g2.setStroke(new BasicStroke(isBoss ? 2.5f : 1.8f));
        g2.drawRoundRect(cx - half, cy - half, size, size, 10, 10);

        // Basit "gözler"
        g2.setColor(new Color(30, 30, 30));
        int eyeOffsetX = 4;
        int eyeOffsetY = 3;
        g2.fillOval(cx - eyeOffsetX - 2, cy - eyeOffsetY, 4, 4);
        g2.fillOval(cx + eyeOffsetX - 2, cy - eyeOffsetY, 4, 4);

        // HP bar
        int barW = size + 10;
        int barH = 5;
        int bx = cx - barW / 2;
        int by = cy - half - 12;

        g2.setColor(Color.BLACK);
        g2.drawRect(bx, by, barW, barH);

        // HP'ye göre renk geçişi (yeşil->kırmızı)
        float hpRatio = (float) en.getHpRatio();
        int rr = (int) (255 * (1 - hpRatio));
        int gg = (int) (200 * hpRatio);
        g2.setColor(new Color(rr, gg, 50));
        int hpWidth = (int) (barW * hpRatio);
        g2.fillRect(bx, by, hpWidth, barH);

        // Özel tip ikonları
        int iconY = by - 9;
        g2.setFont(new Font("Arial", Font.BOLD, 10));

        if (en.getType() == EnemyType.HEALER) {
            g2.setColor(new Color(200, 255, 200));
            g2.drawString("+", cx - 3, iconY);
        } else if (en.getType() == EnemyType.AURA) {
            g2.setColor(new Color(255, 255, 180));
            g2.drawString("◎", cx - 4, iconY);
        } else if (en.getType() == EnemyType.SMART) {
            g2.setColor(new Color(200, 230, 255));
            g2.drawString("∞", cx - 4, iconY);
        } else if (en.getType() == EnemyType.TANK) {
            g2.setColor(new Color(255, 210, 210));
            g2.drawString("■", cx - 4, iconY);
        } else if (en.getType() == EnemyType.FAST) {
            g2.setColor(new Color(255, 235, 200));
            g2.drawString(">", cx - 3, iconY);
        }
    }


