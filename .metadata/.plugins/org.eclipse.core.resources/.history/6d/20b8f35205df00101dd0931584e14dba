    // --------- INPUT (MOUSE / KEYBOARD) ---------
    @Override
    public void mouseClicked(MouseEvent e) {
        int mx = e.getX();
        int my = e.getY();

        switch (state) {
            case MENU:
                handleMenuClick(mx, my);
                break;
            case SETTINGS:
                handleSettingsClick(mx, my);
                break;
            case MAP_SELECT:
                handleMapSelectClick(mx, my);
                break;
            case GAME:
                handleGameClick(e);
                break;
            case PAUSE:
                // pause'da tıklama yok
                break;
        }
    }

    private void handleMenuClick(int mx, int my) {
        if (isInRect(mx, my, 230, 220, 440, 40)) {
            resetGame();
            state = GameState.GAME;
        } else if (isInRect(mx, my, 230, 280, 440, 40)) {
            state = GameState.MAP_SELECT;
        } else if (isInRect(mx, my, 230, 340, 440, 40)) {
            state = GameState.SETTINGS;
        } else if (isInRect(mx, my, 230, 400, 440, 40)) {
            System.exit(0);
        }
    }

    private void handleSettingsClick(int mx, int my) {
        if (isInRect(mx, my, 140, 210, 200, 40)) {
            difficulty = Difficulty.EASY;
        } else if (isInRect(mx, my, 140, 260, 200, 40)) {
            difficulty = Difficulty.NORMAL;
        } else if (isInRect(mx, my, 140, 310, 200, 40)) {
            difficulty = Difficulty.HARD;
        }
    }

    private void handleMapSelectClick(int mx, int my) {
        if (isInRect(mx, my, 120, 150, 260, 260)) {
            currentMap = MapType.MAP1;
        } else if (isInRect(mx, my, 500, 150, 260, 260)) {
            currentMap = MapType.MAP2;
        }
    }

    private void handleGameClick(MouseEvent e) {
        int mx = e.getX();
        int my = e.getY();

        // Meteor skill silahlanmışsa: kule ile uğraşma, meteor at
        if (meteorArmed) {
            castMeteor(mx, my);
            return;
        }

        // Önce tıklanan yerde kule var mı?
        Tower t = getTowerAt(mx, my);

        if (e.getButton() == MouseEvent.BUTTON1) { // sol tık
            if (t != null) {
                selectedTower = t;
                return;
            }

            // Kule yoksa, yeni kule koymayı dene
            if (!canPlaceTower(mx, my)) {
                Toolkit.getDefaultToolkit().beep();
                return;
            }

            int cost = getCostForType(selectedType);
            if (gold >= cost) {
                Tower newTower = new Tower(mx, my, selectedType);
                towers.add(newTower);
                gold -= cost;
                selectedTower = newTower;

                if (selectedType != TowerType.SLOW) {
                    usedNonSlowTower = true;
                }
            } else {
                Toolkit.getDefaultToolkit().beep();
            }
        } else if (e.getButton() == MouseEvent.BUTTON3) { // sağ tık → sat
            if (t != null) {
                int refund = t.getSellValue();
                towers.remove(t);
                gold += refund;
                towerSoldEver = true;
                if (t == selectedTower) selectedTower = null;
            }
        }
    }

    private void castMeteor(int mx, int my) {
        if (meteorCooldownRemaining > 0) {
            Toolkit.getDefaultToolkit().beep();
            meteorArmed = false;
            return;
        }

        // Alan hasarı
        for (Enemy en : enemies) {
            double dx = en.getX() - mx;
            double dy = en.getY() - my;
            double dist = Math.sqrt(dx * dx + dy * dy);
            if (dist <= meteorRadius) {
                en.damage(meteorDamage);
            }
        }
     // 🔥 Görsel efekt: patlama animasyonu ekle
        meteorEffects.add(new MeteorEffect(mx, my));

        // Ekran sarsıntısı başlat
        shakeTicks = 10; // ~10 frame sarsılsın

        meteorCooldownRemaining = meteorCooldownTicks;
        meteorArmed = false;

    }

    private void castFreeze() {
        if (freezeCooldownRemaining > 0) {
            Toolkit.getDefaultToolkit().beep();
            return;
        }

        for (Enemy en : enemies) {
            en.applyFreeze(freezeDurationTicks);
        }
        freezeCooldownRemaining = freezeCooldownTicks;
        // ❄ Ekran overlay etkisi: biraz uzun tut, sonu fade olsun
        freezeOverlayTicks = freezeDurationTicks + 40;
    }

    private boolean isInRect(int mx, int my, int x, int y, int w, int h) {
        return mx >= x && mx <= x + w && my >= y && my <= y + h;
    }

    private Tower getTowerAt(int mx, int my) {
        for (Tower t : towers) {
            double dx = mx - t.getX();
            double dy = my - t.getY();
            double dist = Math.sqrt(dx * dx + dy * dy);
            if (dist <= 18) return t;
        }
        return null;
    }

    private boolean canPlaceTower(int x, int y) {
        // HUD üstüne koyma
        if (y < 80) return false;

        // Sağdaki info paneline çok girmesin
        if (x > getWidth() - 230) return false;

        // Ekran kenarı
        if (x < 30 || x > getWidth() - 30) return false;
        if (y > getHeight() - 30) return false;

        // Diğer kulelerle çakışma
        for (Tower t : towers) {
            double dx = x - t.getX();
            double dy = y - t.getY();
            double dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 35) return false;
        }

        // Yolun çok yakını olmasın (ana ve alt path)
        if (distanceToPath(x, y, pathMain) < 35) return false;
        if (!pathAlt.isEmpty() && distanceToPath(x, y, pathAlt) < 35) return false;

        return true;
    }

    private double distanceToPath(int x, int y, List<Point> path) {
        double min = Double.MAX_VALUE;
        for (int i = 0; i < path.size() - 1; i++) {
            Point a = path.get(i);
            Point b = path.get(i + 1);
            double d = distancePointToSegment(x, y, a.x, a.y, b.x, b.y);
            if (d < min) min = d;
        }
        return min;
    }

    private double distancePointToSegment(double px, double py,
                                          double x1, double y1,
                                          double x2, double y2) {
        double vx = x2 - x1;
        double vy = y2 - y1;
        double wx = px - x1;
        double wy = py - y1;

        double c1 = vx * wx + vy * wy;
        if (c1 <= 0) return Math.hypot(px - x1, py - y1);

        double c2 = vx * vx + vy * vy;
        if (c2 <= c1) return Math.hypot(px - x2, py - y2);

        double b = c1 / c2;
        double bx = x1 + b * vx;
        double by = y1 + b * vy;
        return Math.hypot(px - bx, py - by);
    }

    private int getCostForType(TowerType type) {
        switch (type) {
            case BASIC:
                return 50;
            case SNIPER:
                return 90;
            case SLOW:
                return 70;
        }
        return 50;
    }

    // KEYBOARD
    @Override
    public void keyPressed(KeyEvent e) {
        int code = e.getKeyCode();

        if (state == GameState.GAME || state == GameState.PAUSE) {
            if (code == KeyEvent.VK_1 || code == KeyEvent.VK_NUMPAD1) {
                selectedType = TowerType.BASIC;
            } else if (code == KeyEvent.VK_2 || code == KeyEvent.VK_NUMPAD2) {
                selectedType = TowerType.SNIPER;
            } else if (code == KeyEvent.VK_3 || code == KeyEvent.VK_NUMPAD3) {
                selectedType = TowerType.SLOW;
            } else if (code == KeyEvent.VK_P) {
                if (state == GameState.GAME) state = GameState.PAUSE;
                else if (state == GameState.PAUSE) state = GameState.GAME;
            } else if (code == KeyEvent.VK_ESCAPE) {
                state = GameState.MENU;
            } else if (code == KeyEvent.VK_F5) {
                saveGame();
            } else if (code == KeyEvent.VK_F9) {
                loadGame();
            } else if (code == KeyEvent.VK_U) {
                // Seçili kule upgrade
                if (selectedTower != null) {
                    int cost = selectedTower.getUpgradeCost();
                    if (selectedTower.canUpgrade() && gold >= cost) {
                        gold -= cost;
                        selectedTower.upgrade();
                    } else {
                        Toolkit.getDefaultToolkit().beep();
                    }
                }
            } else if (code == KeyEvent.VK_X) {
                // Seçili kule sat
                if (selectedTower != null) {
                    int refund = selectedTower.getSellValue();
                    towers.remove(selectedTower);
                    gold += refund;
                    towerSoldEver = true;
                    selectedTower = null;
                }
            } else if (code == KeyEvent.VK_Q) {
                // Meteor silahlanır (bir sonraki sol click alanını seçer)
                if (meteorCooldownRemaining <= 0) {
                    meteorArmed = true;
                } else {
                    Toolkit.getDefaultToolkit().beep();
                }
            } else if (code == KeyEvent.VK_F) {
                castFreeze();
            } else if (code == KeyEvent.VK_C) {
                // Hızı azalt: 2.0x -> 1.0x -> 0.5x
                if (speedMultiplier == 2.0) speedMultiplier = 1.0;
                else if (speedMultiplier == 1.0) speedMultiplier = 0.5;
            } else if (code == KeyEvent.VK_V) {
                // Hızı arttır: 0.5x -> 1.0x -> 2.0x
                if (speedMultiplier == 0.5) speedMultiplier = 1.0;
                else if (speedMultiplier == 1.0) speedMultiplier = 2.0;
            }

        } else if (state == GameState.MENU ||
                   state == GameState.SETTINGS ||
                   state == GameState.MAP_SELECT) {
            if (code == KeyEvent.VK_ESCAPE) {
                state = GameState.MENU;
            } else if (code == KeyEvent.VK_F9) {
                loadGame();
            }
        }
    }

    @Override public void keyTyped(KeyEvent e) { }
    @Override public void keyReleased(KeyEvent e) { }

    @Override public void mousePressed(MouseEvent e) { }
    @Override public void mouseReleased(MouseEvent e) { }
    @Override public void mouseEntered(MouseEvent e) { }
    @Override public void mouseExited(MouseEvent e) { }
}

// --------------- ENEMY ---------------
class Enemy {
    private double x, y;
    private int pathIndex = 1;

    private double baseSpeed;
    private double currentSpeed;
    private int slowTicks = 0;
    private int freezeTicks = 0;

    private int maxHp;
    private int hp;
    private boolean reachedEnd = false;
    private boolean alive = true;
    private int reward;
    private int scoreValue;
    private EnemyType type;
    private List<Point> path;

    // Healer için
    private int healCooldown = 0;
    private int healInterval = 150;
    private int healAmount = 20;
    private int healRadius = 80;

    // Aura için
    private int auraRadius = 120;

    public Enemy(double startX, double startY, EnemyType type, List<Point> path) {
        this.x = startX;
        this.y = startY;
        this.type = type;
        this.path = path;

        switch (type) {
            case NORMAL:
                maxHp = 100;
                baseSpeed = 1.2;
                reward = 20;
                scoreValue = 10;
                break;
            case FAST:
                maxHp = 80;
                baseSpeed = 1.9;
                reward = 18;
                scoreValue = 12;
                break;
            case TANK:
                maxHp = 250;
                baseSpeed = 0.7;
                reward = 35;
                scoreValue = 25;
                break;
            case BOSS:
                maxHp = 700;
                baseSpeed = 0.6;
                reward = 100;
                scoreValue = 120;
                break;
            case HEALER:
                maxHp = 120;
                baseSpeed = 1.0;
                reward = 30;
                scoreValue = 18;
                healInterval = 140;
                healAmount = 25;
                healRadius = 90;
                break;
            case AURA:
                maxHp = 180;
                baseSpeed = 1.0;
                reward = 35;
                scoreValue = 22;
                auraRadius = 130;
                break;
            case SMART:
                maxHp = 150;
                baseSpeed = 1.3;
                reward = 40;
                scoreValue = 28;
                break;
        }
        hp = maxHp;
        currentSpeed = baseSpeed;
    }

    public void update(List<Enemy> allEnemies) {
        if (!alive) return;

        // Freeze kontrolü
        if (freezeTicks > 0) {
            freezeTicks--;
            if (hp <= 0) alive = false;
            return;
        }

        // Slow süresini azalt
        if (slowTicks > 0) {
            slowTicks--;
            if (slowTicks == 0) currentSpeed = baseSpeed;
        }

        // Hareket
        if (pathIndex >= path.size()) {
            reachedEnd = true;
            alive = false;
            return;
        }

        Point target = path.get(pathIndex);
        double dx = target.x - x;
        double dy = target.y - y;
        double dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < currentSpeed) {
            x = target.x;
            y = target.y;
            pathIndex++;
        } else {
            x += currentSpeed * dx / dist;
            y += currentSpeed * dy / dist;
        }

        if (hp <= 0) {
            alive = false;
            return;
        }

        // Healer davranışı
        if (type == EnemyType.HEALER) {
            healCooldown++;
            if (healCooldown >= healInterval) {
                healCooldown = 0;
                for (Enemy other : allEnemies) {
                    if (other == this || !other.isAlive()) continue;
                    double ddx = other.getX() - x;
                    double ddy = other.getY() - y;
                    double d = Math.sqrt(ddx * ddx + ddy * ddy);
                    if (d <= healRadius) {
                        other.heal(healAmount);
                    }
                }
            }
        }
    }

    public void damage(int amount) {
        hp -= amount;
        if (hp <= 0) {
            hp = 0;
            alive = false;
        }
    }

    public void heal(int amount) {
        hp += amount;
        if (hp > maxHp) hp = maxHp;
    }

    public void applySlow(int durationTicks, double factor) {
        if (factor <= 0 || factor >= 1) return;
        currentSpeed = baseSpeed * factor;
        slowTicks = Math.max(slowTicks, durationTicks);
    }

    public void applyFreeze(int durationTicks) {
        freezeTicks = Math.max(freezeTicks, durationTicks);
    }

    public boolean isSlowed() {
        return slowTicks > 0;
    }

    public boolean isFrozen() {
        return freezeTicks > 0;
    }

    public boolean isReachedEnd() {
        return reachedEnd;
    }

    public boolean isAlive() {
        return alive;
    }

    public double getX() { return x; }
    public double getY() { return y; }
    public double getHpRatio() { return (double) hp / (double) maxHp; }
    public int getReward() { return reward; }
    public int getScoreValue() { return scoreValue; }
    public EnemyType getType() { return type; }
    public int getAuraRadius() { return auraRadius; }
}

// --------------- TOWER ---------------
class Tower {

    // 🔥 GLOBAL DAMAGE ÇARPANI
    private static double globalDamageMultiplier = 1.0;
    private double x, y;
    private double baseRange;
    private int fireDelay;
    private int cooldown = 0;
    private int bulletDamage;
    private TowerType type;
    private int level = 1;
    private final int maxLevel = 3;
    private boolean slowTower = false;

    private int baseCost;
    private int totalInvested;

    public Tower(double x, double y, TowerType type) {
        this.x = x;
        this.y = y;
        this.type = type;

        switch (type) {
            case BASIC:
                baseRange = 140;
                fireDelay = 28;
                bulletDamage = 24;
                baseCost = 50;
                break;
            case SNIPER:
                baseRange = 260;
                fireDelay = 70;
                bulletDamage = 60;
                baseCost = 90;
                break;
            case SLOW:
                baseRange = 160;
                fireDelay = 40;
                bulletDamage = 10;
                baseCost = 70;
                slowTower = true;
                break;
        }
        totalInvested = baseCost;
    }

    public static void setGlobalDamageMultiplier(double value) {
        globalDamageMultiplier = value;
    }

    public void update(List<Enemy> enemies, List<Bullet> bullets) {
        if (cooldown > 0) {
            cooldown--;
            return;
        }

        // Aura düşmanı varsa menzil düşsün
        double effectiveRange = baseRange;
        for (Enemy en : enemies) {
            if (!en.isAlive()) continue;
            if (en.getType() == EnemyType.AURA) {
                double dx = en.getX() - x;
                double dy = en.getY() - y;
                double d = Math.sqrt(dx * dx + dy * dy);
                if (d <= en.getAuraRadius()) {
                    effectiveRange *= 0.7; // menzil düşür
                }
            }
        }

        Enemy target = null;
        double closestDist = Double.MAX_VALUE;

        for (Enemy en : enemies) {
            if (!en.isAlive()) continue;
            double dx = en.getX() - x;
            double dy = en.getY() - y;
            double dist = Math.sqrt(dx * dx + dy * dy);
            if (dist <= effectiveRange && dist < closestDist) {
                closestDist = dist;
                target = en;
            }
        }

        if (target != null) {
            boolean slow = slowTower;
            double slowFactor = slow ? 0.5 : 1.0;
            int slowDuration = slow ? 90 : 0;

            // Global damage çarpanını uygula
            int dmg = (int) Math.round(bulletDamage * globalDamageMultiplier);

            bullets.add(new Bullet(x, y, target, dmg, slow, slowFactor, slowDuration));
            cooldown = fireDelay;
        }
    }

    public boolean canUpgrade() {
        return level < maxLevel;
    }

    public int getUpgradeCost() {
        return 30 + level * 25;
    }

    public void upgrade() {
        if (!canUpgrade()) return;
        totalInvested += getUpgradeCost();
        level++;
        baseRange += 30;
        bulletDamage += (slowTower ? 5 : 15);
        fireDelay = Math.max(10, fireDelay - 6);
    }

    // Save'den yükleme için maliyet almadan upgrade
    public void forceUpgradeWithoutCost() {
        if (!canUpgrade()) return;
        level++;
        baseRange += 30;
        bulletDamage += (slowTower ? 5 : 15);
        fireDelay = Math.max(10, fireDelay - 6);
    }

    public int getSellValue() {
        return (int) (totalInvested * 0.6);
    }

    public double getX() { return x; }
    public double getY() { return y; }
    public double getRangeBase() { return baseRange; }

    // Çizim için (aura düşmanı olmasa da base menzili gösteriyoruz)
    public double getRangeDisplay() { return baseRange; }

    public TowerType getType() { return type; }
    public int getLevel() { return level; }
    public int getBulletDamage() { return bulletDamage; }
    public int getFireDelay() { return fireDelay; }
}

// --------------- BULLET ---------------
class Bullet {
    private double x, y;
    private double speed = 4.6;
    private Enemy target;
    private boolean alive = true;
    private int damage;

    private boolean slow;
    private double slowFactor;
    private int slowDuration;
    // Trail (mermi izi) için
    private java.util.List<double[]> trail = new java.util.ArrayList<>();
    private int maxTrail = 8;

    public Bullet(double x, double y, Enemy target, int damage,
                  boolean slow, double slowFactor, int slowDuration) {
        this.x = x;
        this.y = y;
        this.target = target;
        this.damage = damage;
        this.slow = slow;
        this.slowFactor = slowFactor;
        this.slowDuration = slowDuration;
        // İlk pozisyonu trail'e ekle
        trail.add(new double[]{x, y});
    }

    public void update() {
        if (!alive || target == null || !target.isAlive()) {
            alive = false;
            return;
        }
        

        double dx = target.getX() - x;
        double dy = target.getY() - y;
        double dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < speed || dist == 0) {
            target.damage(damage);
            if (slow) {
                target.applySlow(slowDuration, slowFactor);
            }
            alive = false;
        } else {
            x += speed * dx / dist;
            y += speed * dy / dist;

            // Yeni pozisyonu trail'e ekle
            trail.add(new double[]{x, y});
            if (trail.size() > maxTrail) {
                trail.remove(0); // en eski noktayı at
            }}
        }
        public java.util.List<double[]> getTrail() {
            return trail;

    }

    public boolean isAlive() { return alive; }
    public double getX() { return x; }
    public double getY() { return y; }
}

//--------------- METEOR EFFECT ---------------
class MeteorEffect {
    private double x, y;
    private int age = 0;
    private int maxAge = 20;      // kaç frame sürecek
    private int maxRadius = 110;  // en büyük yarıçap

    public MeteorEffect(int x, int y) {
        this.x = x;
        this.y = y;
    }

    public void update() {
        age++;
    }

    public boolean isAlive() {
        return age < maxAge;
    }

    public void draw(Graphics2D g2) {
        float t = age / (float) maxAge; // 0..1
        int radius = (int) (maxRadius * t);
        int alpha = (int) (180 * (1f - t));
        if (alpha < 0) alpha = 0;

        // Dış halka
        g2.setStroke(new BasicStroke(3));
        g2.setColor(new Color(255, 140, 0, alpha));
        g2.drawOval((int) x - radius, (int) y - radius, radius * 2, radius * 2);

        // İç parlama
        int innerR = radius / 3;
        if (innerR < 5) innerR = 5;
        int innerAlpha = alpha - 60;
        if (innerAlpha < 0) innerAlpha = 0;
        g2.setColor(new Color(255, 220, 120, innerAlpha));
        g2.fillOval((int) x - innerR, (int) y - innerR, innerR * 2, innerR * 2);
    }
}

//--------------- DEATH PARTICLE ---------------
class DeathParticle {
    private double x, y;
    private double vx, vy;
    private int age = 0;
    private int maxAge = 25;
    private Color color;

    public DeathParticle(double x, double y, double vx, double vy, Color color) {
        this.x = x;
        this.y = y;
        this.vx = vx;
        this.vy = vy;
        this.color = color;
    }

    public void update() {
        age++;
        x += vx;
        y += vy;
        // hafif yerçekimi efekti
        vy += 0.15;
    }

    public boolean isAlive() {
        return age < maxAge;
    }

    public void draw(Graphics2D g2) {
        float t = age / (float) maxAge; // 0..1
        int alpha = (int) (255 * (1f - t));
        if (alpha < 0) alpha = 0;

        g2.setColor(new Color(color.getRed(), color.getGreen(), color.getBlue(), alpha));
        int size = 4;
        g2.fillRect((int) x - size / 2, (int) y - size / 2, size, size);
    }
}

//--------------- FLOATING TEXT ---------------
class FloatingText {
    private double x, y;
    private String text;
    private Color baseColor;
    private int age = 0;
    private int maxAge = 40; // ne kadar kalacak

    public FloatingText(double x, double y, String text, Color color) {
        this.x = x;
        this.y = y;
        this.text = text;
        this.baseColor = color;
    }

    public void update() {
        age++;
        y -= 0.7; // yukarı doğru süzülsün
    }

    public boolean isAlive() {
        return age < maxAge;
    }

    public void draw(Graphics2D g2) {
        float t = age / (float) maxAge;
        int alpha = (int) (255 * (1f - t));
        if (alpha < 0) alpha = 0;

        g2.setFont(new Font("Arial", Font.BOLD, 12));
        g2.setColor(new Color(baseColor.getRed(), baseColor.getGreen(), baseColor.getBlue(), alpha));

        g2.drawString(text, (int) x, (int) y);
    }
}
